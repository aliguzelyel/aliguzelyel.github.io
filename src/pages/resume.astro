---
import BaseLayout from '../layouts/BaseLayout.astro';
import CvContent from '../components/CvContent.astro';
import IconGithub from '../components/icons/Github.astro';
import IconLinkedin from '../components/icons/Linkedin.astro';
import IconMail from '../components/icons/Mail.astro';
import { site } from '../data/site';
---

<BaseLayout title="Resume" description={`Resume of ${site.name} ${site.role}.`}>
  <section class="section-pad border-b border-line">
    <div class="container-x grid grid-cols-1 gap-10 md:grid-cols-12 md:gap-8">
      <!-- Left: identity + actions -->
      <aside class="self-start md:sticky md:top-28 md:col-span-4">
        <p class="eyebrow">Resume</p>
        <h1 class="mt-5 text-4xl font-semibold md:text-5xl">{site.name}</h1>
        <p class="mt-3 text-ink-muted">
          {site.role}{site.location && ` · ${site.location}`}
        </p>

        {
          site.facts.length > 0 && (
            <dl class="mt-7 space-y-4 border-t border-line pt-6">
              {site.facts.map((fact) => (
                <div>
                  <dt class="eyebrow">{fact.label}</dt>
                  <dd class="mt-1 text-sm font-medium text-ink">
                    {fact.value}
                  </dd>
                </div>
              ))}
            </dl>
          )
        }

        <div class="mt-7 flex flex-wrap items-center gap-1">
          {
            site.email && (
              <a
                href={`mailto:${site.email}`}
                class="inline-flex size-11 items-center justify-center rounded-full text-ink-muted transition-colors hover:bg-accent-soft hover:text-accent"
                aria-label="Send an email"
              >
                <IconMail />
              </a>
            )
          }
          {
            site.github && (
              <a
                href={site.github}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex size-11 items-center justify-center rounded-full text-ink-muted transition-colors hover:bg-accent-soft hover:text-accent"
                aria-label="GitHub profile (opens in a new tab)"
              >
                <IconGithub />
              </a>
            )
          }
          {
            site.linkedin && (
              <a
                href={site.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex size-11 items-center justify-center rounded-full text-ink-muted transition-colors hover:bg-accent-soft hover:text-accent"
                aria-label="LinkedIn profile (opens in a new tab)"
              >
                <IconLinkedin />
              </a>
            )
          }
        </div>
      </aside>

      <!-- Right: CV content (shared with the home page section) -->
      <div class="space-y-14 md:col-span-8 md:col-start-5">
        <CvContent />
      </div>
    </div>
  </section>
</BaseLayout>
