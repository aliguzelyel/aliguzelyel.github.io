---
import { site } from '../data/site';

const year = new Date().getFullYear();

const links = [
  { href: '/', label: 'Home' },
  { href: '/projects', label: 'Projects' },
  { href: '/resume', label: 'Resume' },
  ...(site.email ? [{ href: `mailto:${site.email}`, label: 'Email' }] : []),
  ...(site.linkedin
    ? [{ href: site.linkedin, label: 'LinkedIn', external: true }]
    : []),
  ...(site.github
    ? [{ href: site.github, label: 'GitHub', external: true }]
    : []),
];
---

<footer class="no-print border-t border-line bg-surface">
  <div
    class="container-x flex flex-col gap-8 py-12 md:flex-row md:items-start md:justify-between"
  >
    <div class="max-w-xs">
      <p class="font-semibold tracking-tight">{site.name}</p>
      <p class="mt-1 text-sm leading-relaxed text-ink-muted">
        {site.role} · {site.location}
      </p>
    </div>

    <nav class="flex flex-wrap gap-x-6 gap-y-3 text-sm" aria-label="Footer">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="text-ink-muted transition-colors duration-150 hover:text-accent"
            target={'external' in link && link.external ? '_blank' : undefined}
            rel={
              'external' in link && link.external
                ? 'noopener noreferrer'
                : undefined
            }
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <p class="text-sm text-ink-muted">
      © {year}
      {site.name}
    </p>
  </div>
</footer>
