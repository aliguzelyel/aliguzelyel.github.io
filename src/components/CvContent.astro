---
import Reveal from './Reveal.astro';
import Tag from './Tag.astro';
import { site } from '../data/site';
import { experience } from '../data/experience';
import { dateRange } from '../utils/dates';
---

<!-- Experience -->
<div>
  <Reveal>
    <div class="flex items-baseline justify-between border-b border-line pb-3">
      <h2 class="eyebrow text-ink">Experience</h2>
      <span class="font-mono text-xs text-ink-muted">{experience.length}</span>
    </div>
  </Reveal>
  {
    experience.length === 0 ? (
      <p class="mt-5 text-sm text-ink-muted">
        Entries can be added in{' '}
        <code class="font-mono">src/data/experience.json</code>.
      </p>
    ) : (
      <div class="mt-6 space-y-8">
        {experience.map((entry) => (
          <div>
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
              <h3 class="text-lg font-semibold">
                {entry.role}
                <span class="font-normal text-ink-muted"> · {entry.org}</span>
              </h3>
              <p class="font-mono text-xs text-ink-muted">
                {dateRange(entry.start, entry.end)}
              </p>
            </div>
            {(entry.bullets ?? []).length > 0 && (
              <ul class="mt-3 list-disc space-y-1.5 pl-5 text-sm leading-relaxed text-ink-muted">
                {(entry.bullets ?? []).map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
            )}
          </div>
        ))}
      </div>
    )
  }
</div>

<!-- Education -->
<div>
  <Reveal>
    <div class="flex items-baseline justify-between border-b border-line pb-3">
      <h2 class="eyebrow text-ink">Education</h2>
      <span class="font-mono text-xs text-ink-muted"
        >{site.education.length}</span
      >
    </div>
  </Reveal>
  {
    site.education.length === 0 ? (
      <p class="mt-5 text-sm text-ink-muted">
        Entries can be added in{' '}
        <code class="font-mono">src/data/profile.json</code>.
      </p>
    ) : (
      <div class="mt-6 space-y-6">
        {site.education.map((item) => (
          <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
            <h3 class="text-lg font-semibold">
              {item.degree}
              <span class="font-normal text-ink-muted"> · {item.org}</span>
            </h3>
            <p class="font-mono text-xs text-ink-muted">
              {dateRange(item.start, item.end)}
            </p>
          </div>
        ))}
      </div>
    )
  }
</div>

<!-- Skills -->
<div>
  <Reveal>
    <div class="flex items-baseline justify-between border-b border-line pb-3">
      <h2 class="eyebrow text-ink">Skills</h2>
      <span class="font-mono text-xs text-ink-muted">{site.skills.length}</span>
    </div>
  </Reveal>
  {
    site.skills.length === 0 ? (
      <p class="mt-5 text-sm text-ink-muted">
        Skills can be added in{' '}
        <code class="font-mono">src/data/profile.json</code>.
      </p>
    ) : (
      <div class="mt-5 flex flex-wrap gap-2">
        {site.skills.map((skill) => (
          <Tag>{skill}</Tag>
        ))}
      </div>
    )
  }
</div>
